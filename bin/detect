#!/usr/bin/env bash
set -eo pipefail

if [ -n "${BUILDPACK_DEBUG:-}" ]; then
  set -x
fi

# One tarball is published per supported stack; anything else has no artifact.
case "${STACK:-}" in
  scalingo-24 | scalingo-26)
    echo "vips"
    exit 0
    ;;
  *)
    echo "vips buildpack supports scalingo-24 and scalingo-26 (got '${STACK:-unset}')" >&2
    exit 1
    ;;
esac
