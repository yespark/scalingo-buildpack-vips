# syntax=docker/dockerfile:1
FROM scalingo/scalingo-24:latest

# Phase 1: System setup (as root)
USER root
RUN mkdir -p /var/log/apt /var/log && \
    apt-get update && apt-get install -y --no-install-recommends \
      ruby-dev \
      libpoppler-glib8 \
      liborc-0.4-0

# Copy entire buildpack to /tmp/buildpack (mirrors real Scalingo layout)
COPY --chown=appsdeck . /tmp/buildpack
RUN chmod +x /tmp/buildpack/bin/compile /tmp/buildpack/bin/detect

# Create cache directory (bin/compile expects $2)
RUN mkdir -p /tmp/cache && chown appsdeck:appsdeck /tmp/cache

# Set STACK so bin/detect works
ENV STACK=scalingo-24

# Phase 2: Run buildpack scripts (as appsdeck)
USER appsdeck

# Test bin/detect
RUN /tmp/buildpack/bin/detect

# Test bin/compile: extracts tarball, generates .profile.d/vips.sh
RUN /tmp/buildpack/bin/compile /app /tmp/cache

# Phase 3: Validate
RUN test -f /app/.profile.d/vips.sh

RUN . /app/.profile.d/vips.sh && vips --version

RUN . /app/.profile.d/vips.sh && \
    ldd /app/vendor/vips/lib/libvips.so | grep "not found" && exit 1 || true

# Phase 4: Ruby integration test
RUN . /app/.profile.d/vips.sh && \
    echo 'source "https://rubygems.org"' > /app/Gemfile && \
    echo 'gem "ruby-vips"' >> /app/Gemfile && \
    cd /app && bundle config set --local path vendor/bundle && bundle install

WORKDIR /app
RUN . /app/.profile.d/vips.sh && \
    bundle exec ruby -e 'require "vips"; puts "Success: ruby-vips linked to #{Vips::LIBRARY_VERSION}"'
