# syntax=docker/dockerfile:1
FROM scalingo/scalingo-24:latest

# Install ruby-dev as root (needed for native extension compilation)
USER root
RUN mkdir -p /var/log/apt /var/log && \
    apt-get update && apt-get install -y --no-install-recommends \
      ruby-dev \
      libpoppler-glib8 \
      liborc-0.4-0

# Switch to appsdeck to match the real Scalingo runtime environment
USER appsdeck

# Copy the built tarball and extract it like bin/compile does
COPY --chown=appsdeck build/scalingo.tar.gz /tmp/vips.tar.gz
RUN mkdir -p /app/vendor/vips && tar -xz -f /tmp/vips.tar.gz -C /app/vendor/vips

# Set the same environment variables that bin/compile generates via .profile.d/vips.sh
ENV PATH="/app/vendor/vips/bin:$PATH"
ENV LD_LIBRARY_PATH="/app/vendor/vips/lib"
ENV LIBRARY_PATH="/app/vendor/vips/lib"
ENV PKG_CONFIG_PATH="/app/vendor/vips/lib/pkgconfig"
ENV CPPPATH="/app/vendor/vips/include"
ENV CPATH="/app/vendor/vips/include"

# Verify all shared library dependencies resolve (catches missing runtime libs)
RUN ldd /app/vendor/vips/lib/libvips.so | grep "not found" && exit 1 || true

# Simulate a real Scalingo app: install ruby-vips via Bundler as appsdeck
RUN mkdir -p /app && \
    echo 'source "https://rubygems.org"' > /app/Gemfile && \
    echo 'gem "ruby-vips"' >> /app/Gemfile && \
    cd /app && bundle config set --local path vendor/bundle && bundle install

# Verify vips works and ruby-vips can link to it
WORKDIR /app
RUN vips --version && \
    bundle exec ruby -e 'require "vips"; puts "Success: ruby-vips linked to #{Vips::LIBRARY_VERSION}"'
